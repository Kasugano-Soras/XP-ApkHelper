<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CarTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#00B088</item>
        <item name="android:windowBackground">#E5E9F1</item>
        <item name="android:statusBarColor">#E5E9F1</item>
        <item name="android:navigationBarColor">#E5E9F1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="CarThemeNight" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#008768</item>
        <item name="android:windowBackground">#14161A</item>
        <item name="android:statusBarColor">#14161A</item>
        <item name="android:navigationBarColor">#14161A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
